@model IEnumerable<AppointmentBookingApp.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div>
        <h2>Appointments</h2>
        <p>Manage scheduled patient appointments.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Book Appointment
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-card">

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h5>No appointments found</h5>
            <p>Book your first appointment to see it here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Mobile</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>AI Summary</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var appointment in Model)
                    {
                        <tr>

                            <td>
                                <strong>@appointment.PatientName</strong>
                            </td>

                            <td>
                                @appointment.MobileNumber
                            </td>

                            <td>
                                @appointment.DoctorName
                            </td>

                            <td>
                                @appointment.AppointmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @appointment.AppointmentTime.ToString(@"hh\:mm")
                            </td>

                            <td>
                                @if (appointment.Status == "Scheduled")
                                {
                                    <span class="status scheduled">
                                        Scheduled
                                    </span>
                                }
                                else if (appointment.Status == "Completed")
                                {
                                    <span class="status completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status cancelled">
                                        Cancelled
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(appointment.AiSummary))
                                {
                                    <span class="ai-summary-list">
                                        @appointment.AiSummary
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not generated
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="action-buttons">

                                    @if (appointment.Status == "Scheduled")
                                    {
                                        <form asp-action="Complete"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Complete
                                            </button>

                                        </form>

                                        <form asp-action="Cancel"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-warning">
                                                Cancel
                                            </button>

                                        </form>
                                    }

                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this appointment?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@appointment.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
