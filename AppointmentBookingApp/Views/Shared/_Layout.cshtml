
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Clinic Living Plus</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="topbar">
        <div class="container">
            <nav class="navbar navbar-expand-lg">

                <a class="navbar-brand"
                   asp-controller="Appointments"
                   asp-action="Index">

                    <span class="brand-icon">+</span>

                    <span>
                        <strong>Clinic Living Plus</strong>
                        <small>Appointment Booking</small>
                    </span>

                </a>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link active"
                       asp-controller="Appointments"
                       asp-action="Index">
                        Appointments
                    </a>
                </div>

            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <span>Clinic Living Plus</span>
                <span>Appointment Management System</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
